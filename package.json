{
  "name": "loopbeats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "dev": "npm run build:audio && npm run dev --workspace @loopbeats/web --",
    "preview": "npm run preview --workspace @loopbeats/web --",
    "build": "npm run build:audio && npm run typecheck && npm run build --workspace @loopbeats/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "npm run spike:wasm:build && npm run build && playwright test",
    "test:browser:input-fx": "node scripts/test-input-fx-preview.mjs",
    "build:wasm": "cargo build --locked --release --target wasm32-unknown-unknown -p loop-engine",
    "check": "npm run check:scaffold && npm run typecheck && npm run lint && npm run format:check && npm test",
    "spike:audio": "npm run dev -- --open /browser-audio-spike/index.html",
    "spike:probe": "node scripts/browser-audio-probe.cjs",
    "spike:wasm:build": "node scripts/build-wasm-spike.mjs",
    "spike:wasm": "npm run spike:wasm:build && npm run dev -- --open /wasm-audio-spike/index.html",
    "build:audio": "node scripts/build-audio.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
