{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoopBeats",
  "version": "0.1.0",
  "identifier": "app.loopbeats.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoopBeats",
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Two-track loopstation",
    "windows": {
      "nsis": { "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false }
    }
  }
}
